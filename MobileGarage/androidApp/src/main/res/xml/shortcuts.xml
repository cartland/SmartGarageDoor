<!--
  Static app shortcuts: long-press the launcher icon.

  Every entry here is a PLACE TO LOOK, never an action on the door. A shortcut
  is a single tap on a menu that opens from a long press, with nowhere to put
  the confirm gesture the door button needs — see LaunchTarget's KDoc.
  ShortcutsResourceTest reads this file and pins each shortcut to a declared
  LaunchTarget through the one extra it may carry.

  targetPackage is the variant's applicationId (debug builds carry a ".debug"
  suffix), supplied as the shortcut_target_package resValue from
  build.gradle.kts, because res/xml cannot see manifest placeholders.
-->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_history"
        android:shortcutId="history"
        android:shortcutLongLabel="@string/shortcut_history_long"
        android:shortcutShortLabel="@string/shortcut_history_short">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="com.chriscartland.garage.MainActivity"
            android:targetPackage="@string/shortcut_target_package">
            <extra
                android:name="com.chriscartland.garage.LAUNCH_TARGET"
                android:value="history" />
        </intent>
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_snooze"
        android:shortcutId="snooze"
        android:shortcutLongLabel="@string/shortcut_snooze_long"
        android:shortcutShortLabel="@string/shortcut_snooze_short">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="com.chriscartland.garage.MainActivity"
            android:targetPackage="@string/shortcut_target_package">
            <extra
                android:name="com.chriscartland.garage.LAUNCH_TARGET"
                android:value="snooze" />
        </intent>
    </shortcut>
</shortcuts>
