<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <!-- Debug-only fixture that draws the home-screen WIDGET at each of its
             declared sizes with canned readings: no ViewModel, no network, no
             auth, no path to the door. Glance is neither Compose nor Layoutlib,
             so an emulator render is the only way to look at it. Driven by
             scripts/generate-widget-screenshots.sh:
             am start -n <appId>/com.chriscartland.garage.debug.WidgetStagesActivity \
               -e stage closed_2x1|closed_4x1|open_4x1|stale_4x1|no_signal_4x1 -->
        <activity
            android:name="com.chriscartland.garage.debug.WidgetStagesActivity"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.DayNight"
            tools:targetApi="29" />
    </application>
</manifest>
