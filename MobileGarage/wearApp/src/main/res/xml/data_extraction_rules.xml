<!--
   Backup / transfer rules for API 31+ (android:dataExtractionRules). For
   API <= 30 see backup_rules.xml, which carries the full rationale.

   Excludes are scoped to <cloud-backup> only, matching the phone:
   <device-transfer> is a direct device-to-device copy that never leaves the
   user's control, and this file re-earns itself from one unauthenticated
   request, so there is nothing to gain by stripping it from a watch-to-watch
   transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="wear_status_cache.preferences_pb" />
    </cloud-backup>
</data-extraction-rules>
