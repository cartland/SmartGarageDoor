<resources>
    <string name="app_name">Garage</string>

    <!-- Door state labels (same wording as the phone Home screen). -->
    <string name="door_state_connecting">Connecting…</string>
    <string name="door_state_unknown">Unknown</string>
    <string name="door_state_closed">Closed</string>
    <string name="door_state_opening">Opening</string>
    <string name="door_state_open">Open</string>
    <string name="door_state_closing">Closing</string>
    <string name="door_state_sensor_conflict">Sensor conflict</string>

    <!-- Remote button hints.

         The "hold to …" hint is keyed off the door state LABEL shown directly
         above it, never the raw DoorPosition, so the two lines always agree.

         Only CLOSED and OPEN rest on an affirmative sensor reading (one sensor
         says so and the other does not contradict it). Every other position is
         inferred — both sensors are quiet and the direction comes from the
         previous state — so those hints name OUR action (sending a remote
         press) instead of predicting the door's response. The garage decides
         what a press does: open, close, or pause. -->
    <string name="button_hint_hold_to_open">Hold to open</string>
    <string name="button_hint_hold_to_close">Hold to close</string>
    <string name="button_hint_hold_to_press_remote">Hold to press the remote</string>
    <string name="button_hint_sending">Sending</string>
    <string name="button_hint_waiting_for_door">Waiting for the door</string>
    <string name="button_hint_server_failed">Server did not respond</string>
    <string name="button_hint_door_failed">Door did not move</string>

    <!-- Auth. -->
    <string name="sign_in">Sign in</string>
    <string name="sign_in_hint">Sign in to control the door</string>
    <string name="sign_in_failed">Sign-in failed</string>
    <string name="checking_sign_in">Checking sign-in…</string>

    <!-- Voice demo (SIMULATED — never reaches the real garage door).

         Wording rule for this surface: anything describing an action is
         conditional ("Would open the door"), and the terminal state says
         outright that nothing was sent. The door line is always labelled
         "Demo door" so the thing visibly reacting is never mistaken for the
         real one. -->
    <string name="voice_demo_simulated">Simulated</string>
    <string name="voice_demo_prompt">Say a door command</string>
    <string name="voice_demo_ready">Tap to speak</string>
    <string name="voice_demo_hint">Try \"open the garage door\"</string>
    <string name="voice_demo_listening">Listening…</string>
    <!-- Shown on the listening screen ONLY until words arrive, then replaced by
         the live transcript. The example is load-bearing rather than
         decorative: the classifier accepts a narrow imperative grammar, so
         this is the difference between a command that works and one refused. -->
    <string name="voice_demo_listening_prompt">Say \"open the garage door\"</string>
    <string name="voice_demo_would_open">Would open the door</string>
    <string name="voice_demo_would_close">Would close the door</string>
    <string name="voice_demo_cancel_hint">Tap anywhere to cancel</string>
    <string name="voice_demo_committing">Would press the remote</string>
    <string name="voice_demo_committed">Nothing was sent</string>
    <string name="voice_demo_committed_hint">The demo door responds instead</string>
    <string name="voice_demo_failed">Demo press failed</string>
    <string name="voice_demo_transcript">\"%1$s\"</string>
    <string name="voice_demo_door">Demo door: %1$s</string>
    <string name="voice_demo_door_moving">Moving</string>

    <!-- Refusals. Same gate as the real feature, so the demo teaches the real
         rules: only a confident, unambiguous imperative acts, and only when
         the door is settled on the opposite side. -->
    <string name="voice_demo_ignored_no_speech">No speech heard</string>
    <string name="voice_demo_ignored_unavailable">No voice input on this watch</string>
    <string name="voice_demo_ignored_not_a_command">Not a door command</string>
    <string name="voice_demo_ignored_not_confident">Not confident enough to act</string>
    <string name="voice_demo_ignored_already_open">Demo door is already open</string>
    <string name="voice_demo_ignored_already_closed">Demo door is already closed</string>
    <string name="voice_demo_ignored_moving">Demo door is moving</string>
    <string name="voice_demo_ignored_state_unknown">Demo door state is unknown</string>
    <string name="voice_demo_ignored_state_changed">Demo door changed. Cancelled.</string>

    <!-- Settings: the page to the door's left. Who you are signed in as, which
         build is running, and the way to the Play Store. -->
    <string name="settings_title">Settings</string>
    <string name="settings_account">Account</string>
    <string name="settings_account_signed_out">Not signed in</string>
    <!-- Never "Not signed in" while auth is still resolving: on a watch that
         takes its session from the paired phone that is a visible moment at
         every cold start, and claiming signed-out during it would be wrong. -->
    <string name="settings_account_resolving">Checking…</string>
    <string name="settings_version">App version</string>
    <string name="settings_local_build">Local build</string>
    <string name="settings_check_for_update">Check for update</string>
    <string name="settings_store_unavailable">No Play Store on this watch</string>

    <!-- Content descriptions. -->
    <string name="cd_garage_door">Garage door</string>
    <string name="cd_voice_demo">Speak a door command, simulated</string>
    <string name="cd_voice_demo_mic">Tap to speak a door command</string>
    <string name="cd_voice_demo_screen">Tap anywhere to cancel and speak again</string>
    <string name="cd_voice_demo_listening">Listening for a door command</string>
    <string name="cd_voice_demo_cancel">Tap to stop</string>
    <string name="cd_arrow_up">Up arrow</string>
    <string name="cd_arrow_down">Down arrow</string>
    <string name="cd_warning">Warning</string>
</resources>
