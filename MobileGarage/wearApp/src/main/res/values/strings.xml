    <!-- Remote button hints.

         The "hold to …" hint is keyed off the door state LABEL shown directly
         above it, never the raw DoorPosition, so the two lines always agree.

         Only CLOSED and OPEN rest on an affirmative sensor reading (one sensor
         says so and the other does not contradict it). Every other position is
         inferred — both sensors are quiet and the direction comes from the
         previous state — so those hints name OUR action (sending a remote
         press) instead of predicting the door's response. The garage decides
         what a press does: open, close, or pause. -->
    <string name="button_hint_hold_to_open">Hold to open</string>
    <string name="button_hint_hold_to_close">Hold to close</string>
    <string name="button_hint_hold_to_press_remote">Hold to press the remote</string>
    <string name="button_hint_sending">Sending</string>
