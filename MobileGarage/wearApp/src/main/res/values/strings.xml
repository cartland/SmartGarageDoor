<resources>
    <string name="app_name">Garage</string>

    <!-- Door state labels (same wording as the phone Home screen). -->
    <string name="door_state_connecting">Connecting…</string>
    <!--
      Replaces "Connecting…" once the settle window has expired and the watch
      still has not heard from the garage. Sentence case, no em dash, per the
      repo string style. Short because the round mask leaves very little room
      at the bottom of the dial.
    -->
    <string name="door_state_no_signal">No signal</string>
    <!-- The one worded freshness line the hero shows for a door it cannot
         vouch for. Same word the tile uses (strategy 1.1). -->
    <string name="door_state_not_confirmed">Not confirmed</string>
    <string name="door_state_unknown">Unknown</string>
    <string name="door_state_closed">Closed</string>
    <string name="door_state_opening">Opening</string>
    <string name="door_state_open">Open</string>
    <string name="door_state_closing">Closing</string>
    <string name="door_state_sensor_conflict">Sensor conflict</string>

    <!-- Remote button hints.

         The "hold to …" hint is keyed off the door state LABEL shown directly
         above it, never the raw DoorPosition, so the two lines always agree.

         Only CLOSED and OPEN rest on an affirmative sensor reading (one sensor
         says so and the other does not contradict it). Every other position is
         inferred — both sensors are quiet and the direction comes from the
         previous state — so those hints name OUR action (sending a remote
         press) instead of predicting the door's response. The garage decides
         what a press does: open, close, or pause. -->
    <string name="button_hint_hold_to_open">Hold to open</string>
    <string name="button_hint_hold_to_close">Hold to close</string>
    <string name="button_hint_hold_to_press_remote">Hold to press the remote</string>
    <string name="button_hint_sending">Sending</string>
    <string name="button_hint_waiting_for_door">Waiting for the door</string>
    <!-- Deliberately not the phone's "Server error": this slot has room and
         "did not respond" is what actually happened (a timeout, not a
         verdict). Recorded as a chosen divergence in the 2026-09-28 audit
         (strategy 1.7), not an accident. -->
    <string name="button_hint_server_failed">Server did not respond</string>
    <string name="button_hint_door_failed">Door did not move</string>
    <!-- The hero's resting line: how long the door has been in its state,
         from the shared ElapsedDuration bucket (the phone's "2 hr 14 min").
         Single unit like the tile beside it ("for 2 hours"): the bottom chord
         holds about a dozen characters. Under a minute is "just now" rather
         than a seconds figure, because the poll loop ticks every ten seconds
         and a number that jumps by ten reads as broken. Hours and days are
         plurals (plurals.xml). -->
    <string name="hero_since_minutes">for %1$d min</string>
    <string name="hero_since_just_now">just now</string>

    <!-- The two GLANCE surfaces: the tile (swipe right from the watch face)
         and the watch-face complication. Both are read-only: they show the
         door and open the app; neither can ever move it. Wording is
         deliberately terse — a glance is read on a round mask, with a wrist
         already dropping.

         The age line exists so the tile can be TRUSTED: a door position shown
         without saying how old it is asks to be believed on nothing. Plurals
         would be the idiomatic choice, but these are only ever reached with a
         bucket the shared CheckInStatusMapper produced, and the abbreviated
         units ("min", "hr") do not inflect — so a plain format string says
         the same thing in less space on a screen that has very little. -->
    <string name="tile_title">Garage</string>
    <!-- How long the door has been in its state. The number is produced by
         the RENDERER from a platform time source, so it keeps counting
         between tile refreshes instead of freezing at whatever it was when
         the layout was built.

         WORDED UNITS, not abbreviations: on the complication a watch face
         renders our text in capitals, and "3H" reads as a code rather than a
         duration ("3H CLOSED" was the report). The tile is not uppercased by
         anyone, but there is no reason for the two surfaces to disagree.

         "min" is number-agnostic so it is safe at 1. "hours" and "days" are
         not, and a dynamic string cannot branch on grammatical number — so
         GarageDoorTileLayout starts each of those at TWO, and they never have
         to render a 1. -->
    <string name="tile_duration_minutes">%1$s min</string>
    <string name="tile_duration_hours">%1$s hours</string>
    <string name="tile_duration_days">%1$s days</string>
    <!-- Liveness, as a word rather than a measurement: two states cannot
         drift the way a figure can. Shown only when we CANNOT vouch for the
         reading — when we can, the running duration is itself the proof. -->
    <!-- Qualifier appended to the door word when the shared GlanceWarning
         applies: "Opening · stuck". The duration line is untouched, so a
         stuck door reads "Opening · stuck" over "22 min". -->
    <string name="tile_warning_stuck">stuck</string>
    <string name="tile_warning_misaligned">misaligned</string>
    <string name="tile_headline_with_warning">%1$s · %2$s</string>
    <!-- Shown in the watch's tile picker, under the app name. -->
    <string name="tile_description">Garage door status</string>


    <!-- Watch-face complication. SEVEN CHARACTERS is a hard limit on the
         short-text slot, and the watch face picks the colours, so unlike the
         tile there is no grey-and-dim to fall back on: doubt has to be in the
         words. See GarageComplicationWords for why the age leads when the
         reading cannot be vouched for.

         The door words are the complication's OWN vocabulary, not the door
         screen's. "Sensor conflict" does not fit; a word chosen on purpose
         says more than an ellipsised one. -->
    <string name="complication_label">Garage door</string>
    <string name="complication_preview_description">Garage door status</string>
    <string name="complication_door_open">Open</string>
    <string name="complication_door_closed">Closed</string>
    <string name="complication_door_opening">Opening</string>
    <string name="complication_door_closing">Closing</string>
    <string name="complication_door_unknown">Unknown</string>
    <!-- Both sensors disagree. Seven characters exactly. -->
    <string name="complication_door_sensor_conflict">Sensors</string>
    <!-- Nothing has ever been heard, so there is no door to name. -->
    <string name="complication_no_data">No data</string>
    <!-- Stands in whenever the age cannot be stated inside seven characters:
         an unknown age, or a reading so old the number would overflow. Says
         the same thing and always fits. -->
    <string name="complication_stale">Stale</string>
    <!-- Leads the short text when the shared GlanceWarning applies and the
         reading is live: a face that renders text alone must not show a
         stuck door as a plain "Opening". Seven characters: "Askew" is the
         one short English word for a door that did not seat. -->
    <string name="complication_warning_stuck">Stuck</string>
    <string name="complication_warning_misaligned">Askew</string>

    <!-- NO AGE STRINGS HERE, deliberately. The one number worth showing is
         how long the door has been in its state, and it is rendered by the
         WATCH FACE (TimeDifferenceComplicationText) so it is correct whenever
         it is read. A complication redraws as rarely as every ten minutes; a
         duration we formatted and froze would be silently wrong by up to that
         much. We also no longer show the check-in age at all: it describes
         our plumbing rather than the garage, and it was the figure most
         guaranteed to be out of date. -->

    <!-- Long-text slots have room for the door and its duration together.
         %2$s is where the running duration lands. -->
    <string name="complication_long_text">%1$s, %2$s</string>
    <!-- Long-text when the reading cannot be vouched for: no duration, since
         a door we have lost contact with may have moved twice since. -->
    <string name="complication_long_stale">%1$s, not confirmed</string>
    <!-- Long-text slots have room for the same word every other surface uses
         when nothing has ever been heard. The SHORT slot keeps "No data": "No
         signal" is nine characters against a budget of seven. -->
    <string name="complication_long_no_signal">No signal</string>
    <!-- Editor preview only, so a fixed string rather than a running one:
         preview data is cached by the system and meant to be constant. -->
    <string name="complication_preview_duration">8 mins</string>

    <!-- Auth. -->
    <string name="sign_in">Sign in</string>
    <string name="sign_in_hint">Sign in to control the door</string>
    <string name="sign_in_failed">Sign-in failed here. Sign in on your phone instead.</string>
    <!-- Resting caption under the watch's Sign in button. Local sign-in cannot
         succeed on some watches; the phone relay is the path that works. -->
    <string name="sign_in_on_phone">Sign in on your phone to use the watch</string>
    <string name="checking_sign_in">Checking sign-in…</string>

    <!-- Voice control. TWO surfaces share one loop and one screen: the LIVE
         one (reached from the mic on the door screen) presses the real garage
         button, and the SIMULATED one (Settings -> Simulated voice) rehearses
         it against a pretend door.

         Keys are grouped accordingly: voice_* is wording both surfaces share,
         voice_live_* speaks about the real door, voice_sim_* about the
         pretend one.

         Wording rule for the simulated set: anything describing an action is
         conditional ("Would open the door"), the terminal state says outright
         that nothing was sent, and the door is always labelled "Demo door" so
         the thing visibly reacting is never mistaken for the real one. -->
    <string name="voice_prompt">Say a door command</string>
    <string name="voice_ready">Tap to speak</string>
    <string name="voice_hint">Try \"open the garage door\"</string>
    <string name="voice_listening">Listening…</string>
    <!-- Shown on the listening screen ONLY until words arrive, then replaced by
         the live transcript. The example is load-bearing rather than
         decorative: the classifier accepts a narrow imperative grammar, so
         this is the difference between a command that works and one refused. -->
    <string name="voice_listening_prompt">Say \"open the garage door\"</string>
    <string name="voice_cancel_hint">Tap anywhere to cancel</string>
    <string name="voice_transcript">\"%1$s\"</string>
    <string name="voice_door_moving">Moving</string>
    <string name="voice_door_stuck">Stuck</string>

    <!-- Refusals whose wording does not depend on which door is in play. -->
    <string name="voice_ignored_no_speech">No speech heard</string>
    <string name="voice_ignored_unavailable">No voice input on this watch</string>
    <string name="voice_ignored_not_a_command">Not a door command</string>
    <string name="voice_ignored_not_confident">Not confident enough to act</string>

    <!-- LIVE surface: this really does press the garage button, so every line
         states what IS happening rather than what would. -->
    <string name="voice_live_door">Door: %1$s</string>
    <string name="voice_live_opening">Opening the door</string>
    <string name="voice_live_closing">Closing the door</string>
    <string name="voice_live_committing">Pressing the remote…</string>
    <string name="voice_live_committed">Command sent</string>
    <string name="voice_live_committed_hint">The door should start moving</string>
    <string name="voice_live_failed">Remote press failed</string>
    <string name="voice_live_ignored_already_open">The door is already open</string>
    <string name="voice_live_ignored_already_closed">The door is already closed</string>
    <string name="voice_live_ignored_moving">The door is moving</string>
    <string name="voice_live_ignored_stuck">The door is stuck. You can close it</string>
    <string name="voice_ignored_server_unreachable">Could not reach the server to confirm</string>
    <string name="voice_live_ignored_state_unknown">Door state is unknown</string>
    <string name="voice_live_ignored_state_changed">The door changed. Cancelled.</string>

    <!-- SIMULATED surface. The marker is the one line that must appear in
         EVERY state, including the listening takeover, because it is the
         safety signal. Upper case is not styling here: it has to survive being
         glanced at over a moving animation. -->
    <string name="voice_sim_marker">SIMULATION</string>
    <string name="voice_sim_subtitle">The real voice control, pretend door</string>
    <string name="voice_sim_door">Demo door: %1$s</string>
    <string name="voice_sim_would_open">Would open the door</string>
    <string name="voice_sim_would_close">Would close the door</string>
    <string name="voice_sim_committing">Would press the remote</string>
    <string name="voice_sim_committed">Nothing was sent</string>
    <string name="voice_sim_committed_hint">The demo door responds instead</string>
    <string name="voice_sim_failed">Demo press failed</string>
    <string name="voice_sim_ignored_already_open">Demo door is already open</string>
    <string name="voice_sim_ignored_already_closed">Demo door is already closed</string>
    <string name="voice_sim_ignored_moving">Demo door is moving</string>
    <string name="voice_sim_ignored_stuck">Demo door is stuck. You could close it</string>
    <string name="voice_sim_ignored_state_unknown">Demo door state is unknown</string>
    <string name="voice_sim_ignored_state_changed">Demo door changed. Cancelled.</string>

    <!-- Settings: the page to the door's left. Who you are signed in as, which
         build is running, and the way to the Play Store. -->
    <string name="settings_title">Settings</string>
    <string name="settings_account">Account</string>
    <string name="settings_account_signed_out">Not signed in</string>
    <!-- Never "Not signed in" while auth is still resolving: on a watch that
         takes its session from the paired phone that is a visible moment at
         every cold start, and claiming signed-out during it would be wrong. -->
    <string name="settings_account_resolving">Checking…</string>
    <string name="settings_voice">Voice</string>
    <string name="settings_version">App version</string>
    <string name="settings_local_build">Local build</string>
    <string name="settings_check_for_update">Check for update</string>
    <!-- Opens the live voice screen against a pretend door, so the interaction
         can be exercised at a desk without the garage moving. -->
    <string name="settings_simulated_voice">Simulated voice</string>
    <string name="settings_store_unavailable">No Play Store on this watch</string>

    <!-- Content descriptions. -->
    <string name="cd_garage_door">Garage door</string>
    <string name="cd_voice">Speak a door command</string>
    <string name="cd_voice_mic">Tap to speak a door command</string>
    <string name="cd_voice_screen">Tap anywhere to cancel and speak again</string>
    <string name="cd_voice_listening">Listening for a door command</string>
    <string name="cd_voice_cancel">Tap to stop</string>
    <string name="cd_arrow_up">Up arrow</string>
    <string name="cd_arrow_down">Down arrow</string>
    <string name="cd_warning">Warning</string>
</resources>
