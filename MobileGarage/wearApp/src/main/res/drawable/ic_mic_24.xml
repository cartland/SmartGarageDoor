<!--
  Material "mic", hand-copied at the standard 24 viewport.

  Why a local drawable instead of Icons.Outlined.Mic: the Wear module depends
  on material-icons-CORE, whose set is only ~48 glyphs and does not include
  Mic. Pulling in material-icons-extended for one glyph would add thousands of
  vectors to a watch APK.

  Deliberately a 24 viewport (not the 960 viewport Material's SVG export
  produces) and rendered via the Icon composable rather than Image + tint —
  both are the documented avoidance for the Layoutlib drop-out described in
  the root CLAUDE.md.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="@android:color/white"
        android:pathData="M12,14c1.66,0 2.99,-1.34 2.99,-3L15,5c0,-1.66 -1.34,-3 -3,-3S9,3.34 9,5v6c0,1.66 1.34,3 3,3zM17.3,11c0,3 -2.54,5.1 -5.3,5.1S6.7,14 6.7,11L5,11c0,3.41 2.72,6.23 6,6.72L11,21h2v-3.28c3.28,-0.48 6,-3.3 6,-6.72h-1.7z" />
</vector>
