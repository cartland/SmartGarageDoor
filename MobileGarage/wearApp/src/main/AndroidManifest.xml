<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Voice demo only, and requested at the moment you first tap the mic —
         never on launch. It buys ONE-TAP speech: RecognizerIntent on Wear goes
         to Gboard's text-entry activity, which makes you confirm the transcript
         before returning it, while SpeechRecognizer hands back text directly.
         Declining is a supported path: the demo falls back to the system flow.
         The microphone is never used by the real remote button. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Android 11+ package visibility: without this, isRecognitionAvailable()
         cannot see a RecognitionService in another package and always reports
         false, silently forcing the slow fallback on every device. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".GarageWearApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault">

        <uses-library
            android:name="com.google.android.wearable"
            android:required="false" />

        <!-- Standalone: the watch signs in and talks to the server directly
             (Wi-Fi / LTE / Bluetooth-proxied network); no phone required. -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <!-- The garage tile: swipe right from the watch face.

             READ-ONLY. Tapping it opens MainActivity; there is no route from
             here to the garage button, deliberately — a tile lives in a
             carousel the user swipes through, which makes it the easiest
             surface in the system to touch by accident, and it cannot express
             the press-and-hold gesture that guards the button in the app.

             The BIND_TILE_PROVIDER permission is what keeps the binding
             system-only; without it any app could bind this service. -->
        <service
            android:name=".tile.GarageDoorTileService"
            android:description="@string/tile_description"
            android:exported="true"
            android:label="@string/tile_title"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>

            <!-- No androidx.wear.tiles.PREVIEW image yet, so the picker falls
                 back to the app icon. A preview is a hand-drawn duplicate of
                 the tile's design, which drifts from it the first time either
                 changes; the honest version is generated from the tile the
                 emulator actually renders (scripts/generate-wear-screenshots.sh
                 now captures it). Wiring that PNG in is the follow-up. -->
        </service>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.DeviceDefault">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
