// Build-setting config for the garage backend secret.
//
// Non-secret values are committed directly in GarageControl/Info.plist (e.g. GARAGE_BASE_URL).
// The SECRET server config key is injected via the GARAGE_SERVER_CONFIG_KEY build
// setting and substituted into Info.plist ($(GARAGE_SERVER_CONFIG_KEY)).
//
// Real secret values go in Secrets.local.xcconfig (GITIGNORED) -- this mirrors how
// Android reads SERVER_CONFIG_KEY from the gitignored local.properties. Create it as:
//
//     GARAGE_SERVER_CONFIG_KEY = your-key-here
//
// When that file is absent (CI, fresh clone), the optional include below is skipped
// and the key stays empty, so the app still builds and runs -- door data just will
// not load (Firebase Auth still works). The key never enters git.

GARAGE_SERVER_CONFIG_KEY =

#include? "Secrets.local.xcconfig"

// PROVISIONING_PROFILE_SPECIFIER for release builds, written by
// .github/workflows/release-ios.yml after it imports the distribution
// certificate and reads the profile's name out of it.
//
// It is set here, on this target's own xcconfig, rather than on the xcodebuild
// command line: command-line build settings apply to EVERY target in the build,
// including the Swift Package dependencies, and those abort the archive with
// "<package> does not support provisioning profiles" the moment a profile is
// specified. A target-level xcconfig reaches only this target. (The rest of the
// signing settings stay on the command line, which the packages tolerate.)
//
// The file is gitignored, so locally the include is skipped and Xcode keeps the
// Automatic signing declared in project.yml -- a local build needs no
// distribution profile.
#include? "Signing.local.xcconfig"
